{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ODS Game Manifest",
  "type": "object",
  "required": [
    "name",
    "team",
    "year",
    "sdgs",
    "engine",
    "repo",
    "play_url",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "team": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "sdgs": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 17
      },
      "minItems": 1
    },
    "engine": {
      "type": "string"
    },
    "tech": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repo": {
      "type": "string",
      "format": "uri"
    },
    "play_url": {
      "type": "string",
      "format": "uri"
    },
    "thumbnail": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "accessibility": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}